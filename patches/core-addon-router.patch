diff --git a/src/server/game/Chat/AddonMessageRouter.cpp b/src/server/game/Chat/AddonMessageRouter.cpp
new file mode 100644
index 00000000000..4762f23e9b4
--- /dev/null
+++ b/src/server/game/Chat/AddonMessageRouter.cpp
@@ -0,0 +1,25 @@
+#include "AddonMessageRouter.h"
+
+#include <vector>
+
+namespace AddonMessageRouter
+{
+    static std::vector<Handler> s_handlers;
+
+    void RegisterHandler(Handler handler)
+    {
+        if (handler)
+            s_handlers.push_back(handler);
+    }
+
+    bool Handle(WorldSession* session, std::string const& msg)
+    {
+        for (Handler handler : s_handlers)
+        {
+            if (handler && handler(session, msg))
+                return true;
+        }
+
+        return false;
+    }
+}
