+void Pet::SavePetStateWithoutSlot()
+{
+    if (!GetOwnerGUID().IsPlayer())
+        return;
+
+    Player* owner = GetOwner()->ToPlayer();
+    if (!owner || m_loading || !GetEntry() || !isControlled() || m_removed || !m_charmInfo)
+        return;
+
+    uint32 curhealth = GetHealth();
+    uint32 curmana = GetPower(POWER_MANA);
+
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+    _SaveAuras(trans);
+    _SaveSpells(trans);
+    _SaveSpellCooldowns(trans);
+
+    CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_UPD_CHAR_PET_NO_SLOT);
+    stmt->SetData(0, GetEntry());
+    stmt->SetData(1, GetNativeDisplayId());
+    stmt->SetData(2, GetUInt32Value(UNIT_CREATED_BY_SPELL));
+    stmt->SetData(3, uint8(getPetType()));
+    stmt->SetData(4, GetLevel());
+    stmt->SetData(5, GetUInt32Value(UNIT_FIELD_PETEXPERIENCE));
+    stmt->SetData(6, uint8(GetReactState()));
+    stmt->SetData(7, GetName());
+    stmt->SetData(8, uint8(HasByteFlag(UNIT_FIELD_BYTES_2, 2, UNIT_CAN_BE_RENAMED) ? 0 : 1));
+    stmt->SetData(9, curhealth);
+    stmt->SetData(10, curmana);
+    stmt->SetData(11, GetPower(POWER_HAPPINESS));
+    stmt->SetData(12, GameTime::GetGameTime().count());
+    stmt->SetData(13, GenerateActionBarData());
+    stmt->SetData(14, m_charmInfo->GetPetNumber());
+    stmt->SetData(15, owner->GetGUID().GetCounter());
+    trans->Append(stmt);
+
+    CharacterDatabase.CommitTransaction(trans);
+}
